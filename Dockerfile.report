FROM mcr.microsoft.com/playwright:v1.59.1-noble

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig*.json vite.config.ts index.html eslint.config.js ./
COPY public ./public
COPY scripts ./scripts
COPY src ./src

RUN npm run report:build
RUN npm prune --omit=dev

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8787
ENV REPORT_STORAGE_DIR=/data

EXPOSE 8787

CMD ["npm", "run", "report:start"]
