{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./build/report",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "src/cases.ts",
    "src/data.ts",
    "src/marketSignals.ts",
    "src/schoolPrograms.ts",
    "src/reporting.ts",
    "src/reportServer.ts"
  ]
}
